@admin_password = Admin123
@admin_username = admin@gmail.com


### login

POST http://localhost:8080/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "admin@gmail.com",
  "password": "Admin123"
}

### refresh_token

POST http://localhost:8080/api/v1/auth/refresh-token HTTP/1.1
Authorization: Bearer {{login.response.body.$.jwt.refreshToken}}
Content-Type: application/json

### register

POST http://localhost:8080/api/v1/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "tung@gmail.com",
  "password": "Tung123",
  "confirmPassword": "Tung123",
  "name": "Tung123"
}

### resend_two_step_verification_mail

POST http://localhost:8080/api/v1/auth/two-step-verification/resend HTTP/1.1

username: admin@gmail.com

### verify_two_step_verification_mail

GET http://localhost:8080/api/v1/auth/two-step-verification HTTP/1.1



### logout

POST http://localhost:8080/api/v1/logout HTTP/1.1
Authorization: Bearer {{login.response.body.$.jwt.refreshToken}}
Content-Type: application/x-www-form-urlencoded
